#!/usr/bin/env bash
#
# Put this project's interfaces where the things that use them look, or take
# them back off.
#
#   ./python/scripts/sortyourpaperya-path wire
#   ./python/scripts/sortyourpaperya-path unwire
#   ./python/scripts/sortyourpaperya-path relock
#
# `wire` builds a virtualenv beside the project, installs the package into it
# in editable mode so edits take effect without reinstalling, and symlinks the
# commands it installs — `sortyourpaperya` and its short name `sypy` — into a
# directory on PATH. Dependencies come from requirements.lock, so two machines
# set up months apart get the same versions; `relock` is how that file is
# deliberately moved forward.
#
# It also links the agent skill into the skills directory, since a skill an
# agent cannot find is no more use than a command that is not on PATH. Both are
# symlinks into the project, so edits to either take effect without reinstalling
# and `unwire` takes both back off.
#
# Uses python3 -m venv rather than `uv tool install --editable`, which would be
# the one-liner, because uv is not required to be installed to use this.
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="${SORTYOURPAPERYA_VENV_DIR:-$PROJECT_DIR/.venv}"
BIN_DIR="${SORTYOURPAPERYA_BIN_DIR:-$HOME/.local/bin}"
LOCK_FILE="$PROJECT_DIR/requirements.lock"

# The command names the package installs, and so the links this puts on PATH.
# Both run the same entry point; `sypy` is the short one, and it is a link
# rather than a shell alias so that anything which is not an interactive shell —
# a script, a supervisor, an agent — can reach it too.
COMMANDS="sortyourpaperya sypy"

# The agent skill, and where an agent looks for one. Claude Code reads
# ~/.claude/skills; SORTYOURPAPERYA_SKILLS_DIR says so for anything else.
SKILL_NAME="sortyourpaperya"
SKILL_SOURCE="$PROJECT_DIR/skills/$SKILL_NAME"
SKILLS_DIR="${SORTYOURPAPERYA_SKILLS_DIR:-$HOME/.claude/skills}"
SKILL_LINK="$SKILLS_DIR/$SKILL_NAME"

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
note() { printf '%s\n' "$1"; }

# Whether a link is one this script created, rather than some other command
# that happens to share the name. Everything destructive checks this first.
links_into_venv() {
  local link="$1"
  [ -L "$link" ] || return 1
  case "$(readlink "$link")" in
    "$VENV_DIR"/*) return 0 ;;
    *) return 1 ;;
  esac
}

# The same question for the skill: a symlink this script made, rather than a
# skill of the same name someone else wrote.
skill_is_ours() {
  [ -L "$SKILL_LINK" ] || return 1
  [ "$(readlink "$SKILL_LINK")" = "$SKILL_SOURCE" ]
}

on_path() {
  case ":$PATH:" in
    *":$BIN_DIR:"* | *":$BIN_DIR/:"*) return 0 ;;
    *) return 1 ;;
  esac
}

link_skill() {
  [ -d "$SKILL_SOURCE" ] || return 0

  # Only into a skills directory whose parent already exists. An agent that is
  # not installed has no skills directory, and inventing its config folder
  # leaves litter on a machine that will never read it. SORTYOURPAPERYA_SKILLS_DIR is how
  # anything else says where to look, and is taken at its word.
  if [ -z "${SORTYOURPAPERYA_SKILLS_DIR:-}" ] && [ ! -d "$HOME/.claude" ]; then
    note "no $HOME/.claude, so the agent skill was not linked"
    note "  set SORTYOURPAPERYA_SKILLS_DIR to where your agent looks for skills"
    return 0
  fi

  # A warning rather than a refusal: the command is installed by now, and a
  # skill of the same name someone else wrote is theirs to keep.
  if { [ -e "$SKILL_LINK" ] || [ -L "$SKILL_LINK" ]; } && ! skill_is_ours; then
    note "warning: $SKILL_LINK was not created by this script; leaving it alone"
    return 0
  fi

  mkdir -p "$SKILLS_DIR"
  rm -f "$SKILL_LINK"
  ln -s "$SKILL_SOURCE" "$SKILL_LINK"
  note "linked $SKILL_LINK -> $SKILL_SOURCE"
}

unlink_skill() {
  { [ -e "$SKILL_LINK" ] || [ -L "$SKILL_LINK" ]; } || return 0
  if ! skill_is_ours; then
    note "$SKILL_LINK was not created by this script; leaving it alone"
    return 0
  fi
  rm -f "$SKILL_LINK"
  note "unlinked $SKILL_LINK"
}

wire() {
  # `install.sh` resolves the interpreter — it knows which candidates are new
  # enough — and passes it down. Called on its own, fall back to python3.
  local python="${SORTYOURPAPERYA_PYTHON:-python3}"
  command -v "$python" >/dev/null 2>&1 || die "$python not found"
  "$python" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 11) else 1)' \
    || die "$python is older than 3.11, which this package requires"

  # Checked before installing anything, so a name clash costs nothing.
  local command link
  for command in $COMMANDS; do
    link="$BIN_DIR/$command"
    if { [ -e "$link" ] || [ -L "$link" ]; } && ! links_into_venv "$link"; then
      die "$link already exists and was not created by this script; remove it first"
    fi
  done

  if [ ! -x "$VENV_DIR/bin/python" ]; then
    note "creating virtualenv at $VENV_DIR"
    "$python" -m venv "$VENV_DIR" \
      || die "could not create a virtualenv. On Debian and its derivatives this
  needs a separate package: sudo apt-get install python3-venv"
  fi

  note "installing sortyourpaperya (editable) into $VENV_DIR"
  "$VENV_DIR/bin/python" -m pip install --quiet --upgrade pip
  if [ -f "$LOCK_FILE" ]; then
    # Pinned versions first, then the package itself with --no-deps, so pip has
    # nothing left to resolve. Installing the package first and the lock after
    # would let pip pick newest-of-the-day for every dependency and then quietly
    # downgrade them, which is the same machine-to-machine drift the lock exists
    # to stop.
    "$VENV_DIR/bin/python" -m pip install --quiet --requirement "$LOCK_FILE"
    "$VENV_DIR/bin/python" -m pip install --quiet --no-deps --editable "$PROJECT_DIR"
  else
    note "warning: no $LOCK_FILE; resolving whatever is newest today"
    "$VENV_DIR/bin/python" -m pip install --quiet --editable "$PROJECT_DIR"
  fi

  mkdir -p "$BIN_DIR"
  for command in $COMMANDS; do
    [ -x "$VENV_DIR/bin/$command" ] \
      || die "install finished but $VENV_DIR/bin/$command is missing"
    link="$BIN_DIR/$command"
    rm -f "$link"
    ln -s "$VENV_DIR/bin/$command" "$link"
    note "wired $link -> $VENV_DIR/bin/$command"
  done

  link_skill

  # `install.sh` says this itself, and says it better: it knows which shell you
  # run and which file that shell reads. Saying it twice is just noise.
  if [ -n "${SORTYOURPAPERYA_FROM_INSTALLER:-}" ]; then
    :
  elif on_path; then
    note "run: sypy --help"
  else
    note ""
    note "$BIN_DIR is not on PATH. Add it:"
    note "  echo 'export PATH=\"$BIN_DIR:\$PATH\"' >> ~/.zshrc && exec zsh"
  fi
}

relock() {
  # Resolved in a throwaway virtualenv rather than from the working one, which
  # also holds the test dependencies and whatever a debugging session left in
  # it. The lock is meant to say what running the tool needs, and nothing else.
  local python="${SORTYOURPAPERYA_PYTHON:-python3}"
  command -v "$python" >/dev/null 2>&1 || die "$python not found"
  local scratch
  scratch="$(mktemp -d)"
  trap 'rm -rf "$scratch"' EXIT

  note "resolving dependencies in a clean virtualenv"
  "$python" -m venv "$scratch/venv"
  "$scratch/venv/bin/python" -m pip install --quiet --upgrade pip
  "$scratch/venv/bin/python" -m pip install --quiet "$PROJECT_DIR"

  {
    sed -n '/^#/p' "$LOCK_FILE" 2>/dev/null || true
    "$scratch/venv/bin/python" -m pip freeze --exclude-editable \
      | grep -iv '^sortyourpaperya' | sort -f
  } > "$scratch/lock"

  if [ -f "$LOCK_FILE" ] && diff -q "$LOCK_FILE" "$scratch/lock" >/dev/null; then
    note "no change; $LOCK_FILE already matches"
    return 0
  fi
  mv "$scratch/lock" "$LOCK_FILE"
  note "wrote $LOCK_FILE — review the diff before committing it"
}

unwire() {
  # Before the command, because the check below refuses outright when the link
  # is not ours — and the skill should still come off when it is.
  unlink_skill

  # Each name on its own: a `sypy` someone else wrote is theirs to keep, and
  # refusing over it should not strand our own `sortyourpaperya` on PATH. The
  # refusal is still an error, reported once every link that is ours is off.
  local command link removed=0 refused=0
  for command in $COMMANDS; do
    link="$BIN_DIR/$command"
    { [ -e "$link" ] || [ -L "$link" ]; } || continue
    if ! links_into_venv "$link"; then
      note "$link was not created by this script; leaving it alone"
      refused=1
      continue
    fi
    rm -f "$link"
    note "unwired $link"
    removed=1
  done

  [ "$refused" = 0 ] || exit 1
  if [ "$removed" = 0 ]; then
    note "nothing to remove in $BIN_DIR"
    return 0
  fi
  note "the virtualenv at $VENV_DIR is left in place; delete it to reclaim space"
}

case "${1:-}" in
  wire) wire ;;
  unwire) unwire ;;
  relock) relock ;;
  *)
    printf 'usage: %s {wire|unwire|relock}\n' "$(basename "$0")" >&2
    printf '\n  wire    install into %s, link %s into %s,\n' \
      "$VENV_DIR" "$COMMANDS" "$BIN_DIR" >&2
    printf '          and link the agent skill into %s\n' "$SKILLS_DIR" >&2
    printf '  unwire  remove the command and skill links\n' >&2
    printf '  relock  re-resolve dependencies and rewrite requirements.lock\n' >&2
    printf '\nOverride with SORTYOURPAPERYA_VENV_DIR / SORTYOURPAPERYA_BIN_DIR / SORTYOURPAPERYA_SKILLS_DIR.\n' >&2
    exit 2
    ;;
esac
